# Copy to .env.local for local development. On Railway, set these under Variables.

# Read-only GitHub token (fine-grained, public repositories only).
# Without it the GitHub API allows 60 requests/hour per IP, and the projects
# section falls back to the "building" message when that limit is hit.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
# GITHUB_USERNAME=restlucas
# PORTFOLIO_TOPIC=portfolio
